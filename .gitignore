# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Configuracion CLAUDE CODE
# CLAUDE.md SÍ se versiona: contiene las normas de accesibilidad obligatorias
# del proyecto y el README lo enlaza como documento de referencia.
.claude

# Configuracion local de Codex
/.codex/


# local env files
.env*.local
.env

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# mensaje de commit local (no versionar)
mensaje_commit.txt

# Salidas locales de auditoría (capturas de scripts/audit-mobile.mjs)
tmp/

# Salidas binarias de la producción del video demo. Los artefactos de texto
# (guion, escenas, storyboard) sí se versionan; los renders no.
video-demo/renders/
video-demo/snapshots/
video-demo/public/clips/*.mp4
